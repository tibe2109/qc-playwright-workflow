# .gitignore cho dự án dùng AI QC Playwright Pipeline

# === AUTH & CREDENTIALS ===
e2e/.auth/
config/auth-roles.json
config/sso-config.json

# === PLAYWRIGHT RUNTIME ===
playwright-report/
test-results/
